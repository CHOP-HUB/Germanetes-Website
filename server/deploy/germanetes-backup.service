[Unit]
Description=Back up the Germanetes SQLite database
After=germanetes.service

[Service]
Type=oneshot
User=germanetes
Group=germanetes
WorkingDirectory=/opt/germanetes/server
EnvironmentFile=-/etc/germanetes/germanetes.env
Environment=DATA_DIR=/var/lib/germanetes
Environment=BACKUP_DIR=/var/lib/germanetes/backups
Environment=BACKUP_KEEP=14
ExecStart=/usr/bin/node /opt/germanetes/server/backup-db.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/germanetes
